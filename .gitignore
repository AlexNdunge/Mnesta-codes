# Compiled source #
###################
*.com
*.class
*.dll
*.exe
*.o
*.so

# Packages #
############
# it's better to unpack these files and commit the raw source
# git has its own built in compression methods
*.7z
*.dmg
*.gz
*.iso
*.jar
*.rar
*.tar
*.zip

# Dependencies #
################
node_modules/

# User-uploaded content (store in Supabase Storage, not git) #
################################################################
uploads/

# Logs and databases #
######################
*.log
*.sql
*.sqlite
# ...except versioned schema/migrations, which belong in git
!supabase/migrations/*.sql

# Environment / secrets (catch nested copies too) #
#####################################################
.env
**/.env
.env.*
!.env.example

# OS generated files #
######################
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
